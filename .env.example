# Local synthetic development only. Copy to .env; never commit real credentials.
APP_ENV=development
MVP_SYNTHETIC_ONLY=true
HOST=127.0.0.1
PORT=4000
# Match your local PostgreSQL service; percent-encode URL password characters.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/mcclinic
# Used only by the explicit synthetic seed command; choose at least 12 characters.
DEMO_PASSWORD=CHANGE_ME_TO_A_LOCAL_DEMO_PASSWORD
# Browser development proxy only; never put server secrets in VITE_* variables.
EHR_API_TARGET=http://127.0.0.1:4000
