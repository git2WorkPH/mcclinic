{
  "name": "clinic-ehr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:api": "pnpm --filter @ehr/api dev",
    "dev:web": "pnpm --filter @ehr/clinical-app dev",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "oxlint apps packages tooling tests codegen.ts playwright.config.ts vitest.config.ts && node tooling/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "test:web": "playwright test",
    "build": "pnpm db:generate && pnpm --filter @ehr/api build && pnpm --filter @ehr/clinical-app build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx tooling/seed-mvp.ts",
    "dev:mvp": "pnpm --filter @ehr/api dev:mvp",
    "test:mvp": "vitest run tests/mvp.integration.test.ts",
    "test:mvp:web": "tsx tooling/run-mvp-browser.ts",
    "db:rename": "tsx tooling/rename-database.ts",
    "dev:mailbox": "tsx tooling/read-local-mail.ts",
    "test:onboarding": "vitest run tests/onboarding.integration.test.ts",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "format:changed": "node tooling/check-format.mjs"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.0",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@graphql-codegen/typescript-resolvers": "6.1.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "graphql": "16.11.0",
    "oxlint": "1.82.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
