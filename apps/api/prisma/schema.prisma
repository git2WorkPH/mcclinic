generator client {
  provider = "prisma-client"
  importFileExtension = "js"
  output = "../src/infrastructure/prisma/generated"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
}
model User {
  email String? @unique
  verifiedAt DateTime? @db.Timestamptz
  credentialVersion Int @default(1)
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  name String
  role String
  passwordHash String
  active Boolean @default(true)
  memberships Membership[]
  sessions Session[]
  consultations Consultation[]
  documents ClinicalDocument[]
  appointments Appointment[]
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  expiresAt DateTime @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
}
model Patient {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  givenName String
  familyName String
  birthDate String
  identityKey String @unique
  phone String @default("")
  email String @default("")
  address String @default("")
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz
  consultations Consultation[]
  documents ClinicalDocument[]
  appointments Appointment[]
  @@index([familyName,givenName,id])
}
model Consultation {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Restrict)
  providerId String @db.Uuid
  provider User @relation(fields:[providerId],references:[id],onDelete:Restrict)
  occurredAt DateTime @db.Timestamptz
  state String @default("OPEN")
  version Int @default(1)
  noteState String @default("DRAFT")
  noteVersion Int @default(0)
  noteText String @default("")
  revisions NoteRevision[]
  documents ClinicalDocument[]
  @@unique([id,patientId])
}
model NoteRevision {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  consultationId String @db.Uuid
  consultation Consultation @relation(fields:[consultationId],references:[id],onDelete:Restrict)
  version Int
  text String
  state String
  authorId String @db.Uuid
  reason String
  previousVersion Int?
  recordedAt DateTime @default(now()) @db.Timestamptz
  @@unique([consultationId,version])
}
model ClinicalDocument {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  kind String
  patientId String @db.Uuid
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Restrict)
  consultationId String? @db.Uuid
  consultation Consultation? @relation(fields:[consultationId,patientId],references:[id,patientId],onDelete:Restrict)
  authorId String @db.Uuid
  author User @relation(fields:[authorId],references:[id],onDelete:Restrict)
  state String @default("DRAFT")
  version Int @default(1)
  content Json
  createdAt DateTime @default(now()) @db.Timestamptz
  revisions DocumentRevision[]
}
model DocumentRevision {
  renderedHtml String?
  issueSnapshot Json?
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  document ClinicalDocument @relation(fields:[documentId],references:[id],onDelete:Restrict)
  version Int
  state String
  content Json
  patientSnapshot Json
  issuerSnapshot Json
  templateVersion String
  authorId String @db.Uuid
  reason String
  previousVersion Int?
  recordedAt DateTime @default(now()) @db.Timestamptz
  @@unique([documentId,version])
}
model Appointment {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  patient Patient @relation(fields:[patientId],references:[id],onDelete:Restrict)
  providerId String @db.Uuid
  provider User @relation(fields:[providerId],references:[id],onDelete:Restrict)
  startsAt DateTime @db.Timestamptz
  endsAt DateTime @db.Timestamptz
  timeZone String
  state String @default("BOOKED")
  version Int @default(1)
  checkedInAt DateTime? @db.Timestamptz
  checkedInBy String? @db.Uuid
  cancellationReason String @default("")
  changes AppointmentChange[]
  @@index([startsAt,id])
}
model AppointmentChange {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  appointmentId String @db.Uuid
  appointment Appointment @relation(fields:[appointmentId],references:[id],onDelete:Restrict)
  version Int
  snapshot Json
  actorId String @db.Uuid
  recordedAt DateTime @default(now()) @db.Timestamptz
  @@unique([appointmentId,version])
}
model AuditEvent {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  actorId String?
  action String
  subjectId String
  outcome String
  version Int?
  correlationId String
  recordedAt DateTime @default(now()) @db.Timestamptz
  @@index([recordedAt,id])
}
model CommandReceipt {
  practiceId String @default("00000000-0000-4000-8000-000000000001") @db.Uuid
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  key String
  fingerprint String
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz
  @@unique([actorId,key])
}

model Practice {
 id String @id @default(uuid()) @db.Uuid
 name String
 branding Json @default("{}")
 version Int @default(1)
 createdAt DateTime @default(now()) @db.Timestamptz
}
model Membership {
 canManage Boolean @default(false)
 id String @id @default(uuid()) @db.Uuid
 practiceId String @db.Uuid
 userId String @db.Uuid
 user User @relation(fields:[userId],references:[id],onDelete:Restrict)
 role String
 active Boolean @default(true)
 version Int @default(1)
 @@unique([practiceId,userId])
}
model PracticeSubscription {
 practiceId String @id @db.Uuid
 plan String @default("SOLO")
 state String @default("TRIAL")
 until DateTime? @db.Timestamptz
 version Int @default(1)
}
model DocumentTemplate {
 id String @id @default(uuid()) @db.Uuid
 practiceId String @db.Uuid
 kind String
 definition Json
 version Int @default(1)
 publishedVersion Int?
 @@unique([practiceId,kind])
}
model TemplateRevision {
 id String @id @default(uuid()) @db.Uuid
 practiceId String @db.Uuid
 templateId String @db.Uuid
 version Int
 definition Json
 authorId String @db.Uuid
 recordedAt DateTime @default(now()) @db.Timestamptz
 @@unique([templateId,version])
}

model AccountToken {
 credentialVersion Int?
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 kind String
 email String
 userId String? @db.Uuid
 practiceId String? @db.Uuid
 invitedBy String? @db.Uuid
 role String?
 practiceName String @default("")
 expiresAt DateTime @db.Timestamptz
 consumedAt DateTime? @db.Timestamptz
 createdAt DateTime @default(now()) @db.Timestamptz
}
model SecurityFactor {
 userId String @id @db.Uuid
 secretCipher String?
 pendingCipher String?
 pendingExpires DateTime? @db.Timestamptz
 enabled Boolean @default(false)
 lastStep Int @default(-1)
 recoveryHashes String[] @default([])
}
model AccountRate {
 key String @id
 count Int @default(1)
}

// Durable identity delivery; no automatic purge or clinical access through this queue.
model IdentityOutbox {
  id String @id @default(uuid()) @db.Uuid
  payloadCipher String
  createdAt DateTime @default(now())
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseId String? @db.Uuid
  attempts Int @default(0)
  deliveredAt DateTime?
  exhaustedAt DateTime?
  @@index([deliveredAt, exhaustedAt, availableAt])
}
